{
  "name": "mise-en-place",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "ingestion:benchmark": "node scripts/recipe-ingestion-benchmark.mjs",
    "ingestion:regression-check": "node scripts/ingestion-regression-check.mjs",
    "check:d1": "d1-sql-gate",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "1.20.18",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.27",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.39.0",
    "tailwind-merge": "^3.4.0",
    "wrangler": "4.166.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/mocker": "4.1.12",
    "dotenv": "^17.3.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.1"
    },
    "@opennextjs/cloudflare": {
      "glob": "14.0.6"
    },
    "glob": {
      "minimatch": "10.2.6"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.22"
    },
    "source-map-js": "1.2.2",
    "rollup": "4.59.0",
    "picomatch": "4.0.4",
    "js-yaml": "4.3.2",
    "form-data": "4.0.6",
    "flatted": "3.4.4",
    "browserslist": "4.29.6",
    "defu": "6.1.7",
    "vite": "7.3.7",
    "esbuild": "0.28.2",
    "@babel/core": "8.1.3",
    "@humanfs/node": "0.16.8"
  }
}
